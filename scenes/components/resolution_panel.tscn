[node name="ScoreLedger" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
text = "八段账本｜基础分 +0 · 原生系数 +0 · 卡牌效果 +0 · 规则连锁/共鸣 +0\n刻印 +0 · 区域异变 +0 · 幸运 +0 · 庄家奖励 +0"
autowrap_mode = 2
theme_override_colors/font_color = Color(0.62, 0.88, 1, 1)
theme_override_font_sizes/font_size = 13

[node name="EngravingTotal" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
