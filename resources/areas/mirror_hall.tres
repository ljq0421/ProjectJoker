[gd_resource type="Resource" script_class="AreaDefinition" format=3]

[ext_resource type="Script" path="res://scripts/areas/area_definition.gd" id="1_area"]
[ext_resource type="Resource" path="res://resources/rooms/mirror_hall/reverse_drill.tres" id="2_room_a"]
[ext_resource type="Resource" path="res://resources/rooms/mirror_hall/double_ledger.tres" id="3_room_b"]
[ext_resource type="Resource" path="res://resources/rooms/mirror_hall/echo_bridge.tres" id="4_room_c"]
[ext_resource type="Resource" path="res://resources/rooms/mirror_hall/symmetric_page.tres" id="5_room_d"]
[ext_resource type="Resource" path="res://resources/encounters/mirror_hall/mirror_lady.tres" id="6_dealer_encounter"]

[resource]
script = ExtResource("1_area")
id = &"mirror_hall"
display_name = "反照牌厅"
first_route_ids = Array[StringName]([&"mirror_room_reverse_drill", &"mirror_room_double_ledger"])
second_route_ids = Array[StringName]([&"mirror_room_echo_bridge", &"mirror_room_symmetric_page"])
rooms = Array[ExtResource("2_room_a")]([ExtResource("2_room_a"), ExtResource("3_room_b"), ExtResource("4_room_c"), ExtResource("5_room_d")])
starting_deck_ids = Array[StringName]([&"starter_nudge_up_1", &"starter_nudge_down_1", &"starter_map_1", &"starter_map_2", &"starter_repeat_1", &"mirror_folded_map", &"starter_amplified_repeat", &"starter_link", &"starter_reverse", &"starter_stable_repeat", &"mirror_soft_echo", &"mirror_hinged_bridge"])
starting_intel_tickets = 6
initial_engraving_id = &"engraving_bridge"
initial_engraving_die_id = &"d3"
initial_engraving_face = 4
dealer_id = &"dealer_mirror_lady"
dealer_encounter = ExtResource("6_dealer_encounter")
dealer_target = 190
shop_offer_ids = Array[StringName]([&"mirror_double_exposure", &"mirror_deep_echo", &"mirror_silver_bridge", &"shop_precision_map", &"shop_triple_repeat", &"shop_amplified_chain"])
engraving_offer_ids = Array[StringName]([&"engraving_afterimage", &"engraving_silver_anchor", &"engraving_backflow_bridge", &"engraving_mirror_prism"])
