[gd_resource type="Resource" script_class="EncounterDefinition" format=3]

[ext_resource type="Script" path="res://scripts/resolution/encounter_definition.gd" id="1_encounter"]
[ext_resource type="Script" path="res://scripts/resolution/encounter_rule_profile.gd" id="2_profile"]
[ext_resource type="Script" path="res://scripts/rules/rule_definition.gd" id="3_rule"]
[ext_resource type="Resource" path="res://resources/rules/templates/rule_echo_table.tres" id="4_echo"]
[ext_resource type="Resource" path="res://resources/rules/templates/rule_slot_targets.tres" id="5_targets"]
[ext_resource type="Resource" path="res://resources/rules/templates/rule_bridge_table.tres" id="6_bridge"]

[sub_resource type="Resource" id="Profile"]
script = ExtResource("2_profile")
resolution_direction = 1
mirror_first_table_card = true
mirror_limit_per_round = 1

[sub_resource type="Resource" id="Rule_left"]
script = ExtResource("3_rule")
id = &"left"
template = ExtResource("4_echo")
display_name = "回声台"
slot_count = 2
coefficient = 3

[sub_resource type="Resource" id="Rule_middle"]
script = ExtResource("3_rule")
id = &"middle"
template = ExtResource("6_bridge")
display_name = "桥接台"
slot_count = 2
coefficient = 2

[sub_resource type="Resource" id="Rule_right"]
script = ExtResource("3_rule")
id = &"right"
template = ExtResource("5_targets")
display_name = "槽位 2 / 5"
slot_count = 2
slot_targets = PackedInt32Array(2, 5)
coefficient = 6

[resource]
script = ExtResource("1_encounter")
id = &"mirror_lady_encounter"
rules = Array[ExtResource("3_rule")]([SubResource("Rule_left"), SubResource("Rule_middle"), SubResource("Rule_right")])
rule_profile = SubResource("Profile")
