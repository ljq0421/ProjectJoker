[gd_resource type="Resource" script_class="RoomDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/rooms/room_definition.gd" id="1_room"]
[ext_resource type="Script" path="res://scripts/resolution/encounter_definition.gd" id="2_encounter"]
[ext_resource type="Script" path="res://scripts/rules/rule_definition.gd" id="3_rule"]

[sub_resource type="Resource" id="Rule_left"]
script = ExtResource("3_rule")
id = &"left"
display_name = "两枚全偶"
condition_type = 1
slot_count = 2
coefficient = 3

[sub_resource type="Resource" id="Rule_middle"]
script = ExtResource("3_rule")
id = &"middle"
display_name = "精确为 9"
slot_count = 2
target_value = 9
coefficient = 2

[sub_resource type="Resource" id="Rule_right"]
script = ExtResource("3_rule")
id = &"right"
display_name = "连续两数"
condition_type = 2
slot_count = 2
coefficient = 2

[sub_resource type="Resource" id="Encounter_main"]
script = ExtResource("2_encounter")
id = &"gold_encounter_even_split"
rules = Array[ExtResource("3_rule")]([SubResource("Rule_left"), SubResource("Rule_middle"), SubResource("Rule_right")])

[resource]
script = ExtResource("1_room")
id = &"gold_room_even_split"
display_name = "偶数分流"
description = "用偶数关系争取高系数，同时保留精确点数和连续路线。"
encounter = SubResource("Encounter_main")
target_total = 110
success_intel_reward = 3
tags = PackedStringArray("奇偶", "关系", "进取")
synergy_tags = PackedStringArray("骰值", "校准", "系数")
