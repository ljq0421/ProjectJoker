[gd_resource type="Resource" script_class="RoomDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/rooms/room_definition.gd" id="1_room"]
[ext_resource type="Script" path="res://scripts/resolution/encounter_definition.gd" id="2_encounter"]
[ext_resource type="Script" path="res://scripts/rules/rule_definition.gd" id="3_rule"]
[ext_resource type="Resource" path="res://resources/rules/templates/rule_exact_sum.tres" id="4_exact"]
[ext_resource type="Resource" path="res://resources/rules/templates/rule_all_even.tres" id="5_even"]
[ext_resource type="Resource" path="res://resources/rules/templates/rule_consecutive.tres" id="6_consecutive"]

[sub_resource type="Resource" id="Rule_left"]
script = ExtResource("3_rule")
id = &"left"
template = ExtResource("4_exact")
display_name = "精确为 10"
slot_count = 2
target_value = 10
coefficient = 3

[sub_resource type="Resource" id="Rule_middle"]
script = ExtResource("3_rule")
id = &"middle"
template = ExtResource("6_consecutive")
display_name = "连续三数"
condition_type = 2
slot_count = 3
coefficient = 2

[sub_resource type="Resource" id="Rule_right"]
script = ExtResource("3_rule")
id = &"right"
template = ExtResource("5_even")
display_name = "单枚偶数"
condition_type = 1
coefficient = 3

[sub_resource type="Resource" id="Encounter_main"]
script = ExtResource("2_encounter")
id = &"gold_encounter_narrow_ledger"
rules = Array[ExtResource("3_rule")]([SubResource("Rule_left"), SubResource("Rule_middle"), SubResource("Rule_right")])

[resource]
script = ExtResource("1_room")
id = &"gold_room_narrow_ledger"
display_name = "窄幅账页"
description = "更高的精确目标压缩选择空间，鼓励用校准和重复稳定得分。"
encounter = SubResource("Encounter_main")
target_total = 120
success_intel_reward = 2
tags = PackedStringArray("点数", "连续", "稳妥")
synergy_tags = PackedStringArray("骰值", "校准", "重复")
