[gd_resource type="Resource" script_class="RoomDefinition" format=3]

[ext_resource type="Script" path="res://scripts/rooms/room_definition.gd" id="1_room"]
[ext_resource type="Script" path="res://scripts/resolution/encounter_definition.gd" id="2_encounter"]
[ext_resource type="Script" path="res://scripts/resolution/encounter_rule_profile.gd" id="3_profile"]
[ext_resource type="Script" path="res://scripts/rules/rule_definition.gd" id="4_rule"]
[ext_resource type="Resource" path="res://resources/restrictions/faceless_hub/three_seats_present.tres" id="5_restriction"]
[ext_resource type="Resource" path="res://resources/rules/templates/rule_all_odd.tres" id="6_odd"]
[ext_resource type="Resource" path="res://resources/rules/templates/rule_maximum_sum.tres" id="7_maximum"]
[ext_resource type="Resource" path="res://resources/rules/templates/rule_fixed_difference.tres" id="8_difference"]

[sub_resource type="Resource" id="Profile"]
script = ExtResource("3_profile")
resolution_direction = 1

[sub_resource type="Resource" id="Rule_left"]
script = ExtResource("4_rule")
id = &"left"
template = ExtResource("6_odd")
display_name = "两枚全奇"
slot_count = 2
coefficient = 5

[sub_resource type="Resource" id="Rule_middle"]
script = ExtResource("4_rule")
id = &"middle"
template = ExtResource("8_difference")
display_name = "固定差 2"
slot_count = 2
difference = 2
coefficient = 5

[sub_resource type="Resource" id="Rule_right"]
script = ExtResource("4_rule")
id = &"right"
template = ExtResource("7_maximum")
display_name = "至多为 7"
slot_count = 2
target_value = 7
coefficient = 5

[sub_resource type="Resource" id="Encounter"]
script = ExtResource("2_encounter")
id = &"faceless_encounter_three_seat_protocol"
rules = Array[ExtResource("4_rule")]([SubResource("Rule_left"), SubResource("Rule_middle"), SubResource("Rule_right")])
rule_profile = SubResource("Profile")

[resource]
script = ExtResource("1_room")
id = &"faceless_room_three_seat_protocol"
display_name = "三席协议"
description = "确认时三张规则台都必须有骰子，要求先满足布局覆盖再追求高分。"
encounter = SubResource("Encounter")
restriction = ExtResource("5_restriction")
target_total = 165
success_intel_reward = 10
tags = PackedStringArray("分配限制", "复合条件", "预演")
synergy_tags = PackedStringArray("布局", "情报", "全台")
