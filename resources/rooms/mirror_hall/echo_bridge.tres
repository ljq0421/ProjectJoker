[gd_resource type="Resource" script_class="RoomDefinition" format=3]

[ext_resource type="Script" path="res://scripts/rooms/room_definition.gd" id="1_room"]
[ext_resource type="Script" path="res://scripts/resolution/encounter_definition.gd" id="2_encounter"]
[ext_resource type="Script" path="res://scripts/resolution/encounter_rule_profile.gd" id="3_profile"]
[ext_resource type="Script" path="res://scripts/rules/rule_definition.gd" id="4_rule"]
[ext_resource type="Resource" path="res://resources/rules/templates/rule_echo_table.tres" id="5_echo"]
[ext_resource type="Resource" path="res://resources/rules/templates/rule_fixed_difference.tres" id="6_difference"]
[ext_resource type="Resource" path="res://resources/rules/templates/rule_bridge_table.tres" id="7_bridge"]

[sub_resource type="Resource" id="Profile"]
script = ExtResource("3_profile")
resolution_direction = 1
mirror_first_table_card = true
mirror_limit_per_round = 1

[sub_resource type="Resource" id="Rule_left"]
script = ExtResource("4_rule")
id = &"left"
template = ExtResource("5_echo")
display_name = "回声台"
slot_count = 2
coefficient = 2

[sub_resource type="Resource" id="Rule_middle"]
script = ExtResource("4_rule")
id = &"middle"
template = ExtResource("7_bridge")
display_name = "桥接台"
slot_count = 2
coefficient = 1

[sub_resource type="Resource" id="Rule_right"]
script = ExtResource("4_rule")
id = &"right"
template = ExtResource("6_difference")
display_name = "固定差 2"
slot_count = 2
difference = 2
coefficient = 3

[sub_resource type="Resource" id="Encounter"]
script = ExtResource("2_encounter")
id = &"mirror_encounter_echo_bridge"
rules = Array[ExtResource("4_rule")]([SubResource("Rule_left"), SubResource("Rule_middle"), SubResource("Rule_right")])
rule_profile = SubResource("Profile")

[resource]
script = ExtResource("1_room")
id = &"mirror_room_echo_bridge"
display_name = "回声桥"
description = "用相邻传递和弱化重复安排从右向左的高系数轨迹。"
encounter = SubResource("Encounter")
build_identity_id = &"table_chain"
target_total = 132
success_intel_reward = 7
tags = PackedStringArray("逆序", "传递", "重复")
synergy_tags = PackedStringArray("桌间", "传递", "重复")
