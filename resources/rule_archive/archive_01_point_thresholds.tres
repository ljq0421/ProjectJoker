[gd_resource type="Resource" script_class="RuleArchiveDefinition" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/rules/rule_archive_definition.gd" id="1_archive"]
[ext_resource type="Script" path="res://scripts/resolution/encounter_definition.gd" id="2_encounter"]
[ext_resource type="Script" path="res://scripts/rules/rule_definition.gd" id="3_rule"]
[ext_resource type="Resource" path="res://resources/rules/templates/rule_exact_sum.tres" id="4_exact"]
[ext_resource type="Resource" path="res://resources/rules/templates/rule_minimum_sum.tres" id="5_minimum"]
[ext_resource type="Resource" path="res://resources/rules/templates/rule_maximum_sum.tres" id="6_maximum"]

[sub_resource type="Resource" id="Rule_left"]
script = ExtResource("3_rule")
id = &"left"
display_name = "精确总和 7"
template = ExtResource("4_exact")
slot_count = 2
target_value = 7
coefficient = 2

[sub_resource type="Resource" id="Rule_middle"]
script = ExtResource("3_rule")
id = &"middle"
display_name = "总和至少 7"
template = ExtResource("5_minimum")
slot_count = 2
target_value = 7
coefficient = 2

[sub_resource type="Resource" id="Rule_right"]
script = ExtResource("3_rule")
id = &"right"
display_name = "总和至多 7"
template = ExtResource("6_maximum")
slot_count = 2
target_value = 7
coefficient = 2

[sub_resource type="Resource" id="Encounter"]
script = ExtResource("2_encounter")
id = &"archive_encounter_01"
rules = Array[ExtResource("3_rule")]([SubResource("Rule_left"), SubResource("Rule_middle"), SubResource("Rule_right")])

[resource]
script = ExtResource("1_archive")
id = &"archive_01"
display_name = "01 · 点数阈值"
group_label = "精确 / 下限 / 上限"
summary = "比较同一组骰子在精确值、最低值和最高值三种公开约束下的分配方式。"
explanation = "三张台都使用两枚骰子。精确台要求总和恰好为 7；下限台要求不少于 7；上限台要求不超过 7。"
encounter = SubResource("Encounter")
hand_ids = Array[StringName]([&"starter_nudge_down_1", &"starter_nudge_up_1", &"starter_map_1", &"starter_repeat_1"])
